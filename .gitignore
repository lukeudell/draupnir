# secrets: never commit. `.env.*` matters as much as `.env`: a stray
# .env.production or .env.local is the same secret in a different filename, and
# `*.env` alone does not match either of them.
.env
.env.*
*.env
!.env.example
dbt/profiles.yml
app/.streamlit/secrets.toml

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# generated data: regenerate with `docker compose --profile seed up`
data/generated/

# os / editor
.DS_Store
Thumbs.db
